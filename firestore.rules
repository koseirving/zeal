rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Videos collection - public read for authenticated users
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin via Firebase Admin SDK
    }
    
    // Video likes collection - authenticated users can manage their own likes
    match /video_likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow update: if false; // Likes should not be updated
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == userId;
      
      // Login history subcollection
      match /login_history/{historyId} {
        allow read: if request.auth != null && 
          request.auth.uid == userId;
        allow write: if request.auth != null && 
          request.auth.uid == userId;
      }
      
      // Video history subcollection  
      match /video_history/{historyId} {
        allow read: if request.auth != null && 
          request.auth.uid == userId;
        allow write: if request.auth != null && 
          request.auth.uid == userId;
      }
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}